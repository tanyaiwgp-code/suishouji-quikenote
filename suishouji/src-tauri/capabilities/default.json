{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口 capability：仅授予笔记文件系统白名单命令（M1-6）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "allow-list-notes",
    "allow-read-note",
    "allow-write-note",
    "allow-delete-note",
    "allow-acquire-note-lock",
    "allow-release-note-lock",
    "allow-assets-import",
    "allow-assets-import-base64",
    "allow-note-abs-path",
    "allow-docx-import",
    "allow-docx-export",
    "allow-get-app-settings",
    "allow-set-app-root",
    "allow-set-autostart",
    "allow-set-note-title",
    "dialog:default"
  ]
}
