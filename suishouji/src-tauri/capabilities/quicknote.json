{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quicknote",
  "description": "快速记录浮窗 capability：笔记命令 + 窗口控制命令（M4）",
  "windows": ["quicknote"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-list-notes",
    "allow-read-note",
    "allow-write-note",
    "allow-delete-note",
    "allow-acquire-note-lock",
    "allow-release-note-lock",
    "allow-assets-import",
    "allow-assets-import-base64",
    "allow-note-abs-path",
    "allow-open-main-window",
    "allow-hide-quicknote",
    "allow-docx-import",
    "allow-docx-export",
    "allow-get-app-settings",
    "allow-set-app-root",
    "allow-set-autostart",
    "dialog:default",
    "log:default"
  ]
}
